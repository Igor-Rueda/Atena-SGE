# ============================================================================
# Atenas SGE — modelo de variáveis de ambiente (arquivo: env.example)
#
# Copie para ".env" (que NUNCA vai para o git) e troque os valores "troque-...".
#   cp env.example .env
#
# No compose local, todos os serviços leem este mesmo .env (env_file). No Portainer,
# cada variável é cadastrada na tela "Environment variables" da stack, e o compose
# entrega a cada serviço só as que ele usa (ver docker-compose.portainer.yml).
# ============================================================================

# ---------- portas (dentro da rede do Docker; só o app é publicado) ----------
PORT_APP=3000
PORT_AUTH=4000
PORT_PROFILE=4100
PORT_PAGAMENTOS=4200
PORT_LOG=5000
PORT_REGRESSAO=6000

# ---------- endereços internos (nomes dos serviços no compose) ----------
AUTH_SERVICE_URL=http://auth-service:4000
PROFILE_SERVICE_URL=http://profile-service:4100
PAGAMENTOS_SERVICE_URL=http://pagamentos:4200
LOG_SERVICE_URL=http://log-service:5000
REGRESSAO_SERVICE_URL=http://regressao:6000

# endereço público do site, sem barra final (vai nos links do e-mail e nos redirects do Stripe)
# em produção: https://<seu-dominio>
APP_URL=http://localhost:3000

# ---------- segredos compartilhados ----------
# JWT_SECRET: assina o login. Precisa ser IDÊNTICO no app e no auth-service.
# INTERNAL_API_KEY: protege as chamadas entre serviços (app, auth-service, pagamentos, regressao).
# Gere cada um com:  openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
INTERNAL_API_KEY=troque-por-outra-chave-longa-e-aleatoria

# ---------- banco de dados (MariaDB) ----------
# Usado por app, auth-service, pagamentos, profile-service e regressao.
DB_HOST=troque-pelo-host-do-mariadb
DB_USER=troque-pelo-usuario
DB_PASSWORD=troque-pela-senha
DB_NAME=troque-pelo-nome-do-banco

# ---------- Redis (log-service) ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- e-mail (redefinição de senha, no auth-service) ----------
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=troque-pelo-usuario-smtp
SMTP_PASS=troque-pela-senha-smtp

# ---------- Stripe (serviço de pagamentos) ----------
# Use chaves de TESTE (sk_test_...) enquanto desenvolve.
STRIPE_SECRET_KEY=sk_test_troque
# Local: o valor impresso por "npm run stripe:listen". Produção: o do endpoint cadastrado
# no painel do Stripe (https://<seu-dominio>/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=whsec_troque
# Price do plano Expert (mensal, R$ 149), criado no painel do Stripe
STRIPE_PRICE_EXPERT=price_troque

# ---------- arquivos de perfil: Garage (S3 interno) + profile-service ----------
GARAGE_ENDPOINT=http://garage:3900
GARAGE_REGION=garage
GARAGE_BUCKET=avatars
GARAGE_ACCESS_KEY_ID=troque-pela-access-key-do-garage
GARAGE_SECRET_ACCESS_KEY=troque-pela-secret-key-do-garage
# tamanho máximo da foto de perfil, em MB (app e profile-service)
PROFILE_IMAGE_MAX_SIZE_MB=5