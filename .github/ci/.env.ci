# Existente para evitar que as aplicações quebrem no teste, devido às chamadas de variaveis de ambiente# Variáveis de ambiente usadas SOMENTE pelo pipeline de CI (job build-and-test).
#
# POR QUE ESTE ARQUIVO EXISTE: o ambiente do GitHub Actions é uma máquina
# limpa, sem nenhum ".env" -- sem este arquivo, process.env.JWT_SECRET,
# process.env.AUTH_SERVICE_URL, process.env.LOG_SERVICE_URL etc. ficariam
# undefined dentro dos containers, e a aplicação quebraria só por falta de
# configuração (não por um bug real no código). Este arquivo garante que
# app, auth-service e log-service sobem com tudo que precisam para se
# enxergar entre si e responder às requisições de teste.
#
# Todos os valores aqui são fake/descartáveis -- nunca aponte isso para
# serviços reais (Stripe, SMTP, etc.), e nunca reaproveite este JWT_SECRET
# em produção.
#
# NÃO inclua DB_HOST/DB_USER/DB_PASSWORD/DB_NAME aqui: essas 4 variáveis já
# são definidas diretamente no docker-compose.ci.yml (que sobrescreve
# qualquer valor vindo deste arquivo para app e auth-service, já que
# "environment:" no compose sempre tem prioridade sobre "env_file"). Manter
# essas 4 variáveis só em um lugar evita os dois arquivos "discordarem"
# silenciosamente sobre qual é o host do banco de teste.

PORT_APP=3000
PORT_AUTH=4000
PORT_LOG=5000

JWT_SECRET=segredo-apenas-para-ci-nunca-reutilizar-em-producao

AUTH_SERVICE_URL=http://auth-service:4000
LOG_SERVICE_URL=http://log-service:5000

# O SMTP e a regressão não são exercitados pelo teste de cadastro/login -- valores
# fake bastam só para as variáveis existirem e o processo não quebrar ao subir
REGRESSAO_SERVICE_URL=http://regressao:6000
PORT_REGRESSAO=6000
APP_URL=http://localhost:3000
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=ci@exemplo.com
SMTP_PASS=senha-fake

REDIS_HOST=redis
REDIS_PORT=6379

PORT_PAGAMENTOS=4200
PAGAMENTOS_SERVICE_URL=http://pagamentos:4200
INTERNAL_API_KEY=ci-chave-interna-fake
STRIPE_SECRET_KEY=sk_test_ci_fake
STRIPE_WEBHOOK_SECRET=whsec_ci_teste_webhook
STRIPE_PRICE_EXPERT=price_ci_expert